# 复制本文件为 backend/.env 后填写。不创建 .env 时，系统使用本地夹具，不调用模型。

# fixture：按演示案例规则抽取，不需要密钥
# llm：调用下方 OpenAI 兼容接口
EXTRACT_MODE=fixture

# 兼容接口根路径，需要包含版本前缀，例如 https://api.openai.com/v1
LLM_API_BASE=https://api.openai.com/v1

# 在这里填写密钥。留空且 EXTRACT_MODE=llm 时，解析会失败并保留已上传的来源。
LLM_API_KEY=

# 模型名按服务商实际名称填写
LLM_MODEL=gpt-4o-mini

# 可选。不填则使用 backend/data/danji.db
# DANJI_DATABASE=

# 图片，以及没有文字层的 PDF。留空时这两类会提示未配置，不影响 TXT、CSV、XLSX、DOCX 和带文字的 PDF。
# 火山方舟 Responses API。OCR_API_BASE 填到版本前缀，代码会请求 {OCR_API_BASE}/responses。留空时沿用 LLM_API_BASE。
OCR_API_BASE=https://ark.cn-beijing.volces.com/api/v3
OCR_API_KEY=YOUR_API_KEY
OCR_MODEL=doubao-seed-2-0-mini-260428

# 录音转写。留空时上传音频会提示未配置，不影响文本、表格和文档。
# 与图片共用方舟 /responses。本地录音以 input_audio 的 data URL 发送。ASR_API_BASE 留空时沿用 LLM_API_BASE。
ASR_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ASR_API_KEY=YOUR_API_KEY
ASR_MODEL=doubao-seed-2-0-mini-260428

# 主接口失败（超时、连接失败、5xx、429、402）时的一次备用 chat.completions。HTTP 200 不会改走这里。
# 也认 LLM_FALLBACK_API_KEY / LLM_FALLBACK_API_BASE / LLM_FALLBACK_MODEL 这组别名。
ARK_FALLBACK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_FALLBACK_API_KEY=YOUR_API_KEY
ARK_FALLBACK_MODEL=doubao-seed-2-1-turbo-260628
